# Application
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
DEBUG=True
ALLOW_GUEST_ACCESS=True
FRONTEND_URL=http://localhost:5173

# Database (use the Supabase session pooler URL in production)
DATABASE_URL=sqlite:///./youtube_ai.db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Pexels API (free stock footage) - get key at https://www.pexels.com/api/
PEXELS_API_KEY=

# fal.ai video generation - keep the secret key in this backend-only file
FAL_KEY=
FAL_VIDEO_ENABLED=false
FAL_VIDEO_MODEL=fal-ai/veo3.1/fast
FAL_VIDEO_TIMEOUT_SECONDS=600

# Google OAuth / YouTube Data API
# Create project at https://console.cloud.google.com/
# Enable YouTube Data API v3
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:8000/api/v1/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Google/GitHub login callbacks (Google can use the same OAuth client as YouTube)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
